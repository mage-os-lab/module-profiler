# Keep the dist archive (and therefore vendor/mage-os/module-profiler) to runtime files only.
# Everything below is stripped from `git archive`, GitHub zipballs and `composer install --prefer-dist`.
#
# Test/ is deliberately NOT listed: CI installs this package from a path repository, and Magento's
# unit runner is pointed at vendor/mage-os/module-profiler/Test/Unit.

/.github          export-ignore
/docs             export-ignore
/phpcs.xml.dist   export-ignore
/phpstan.neon     export-ignore
/phpunit.xml.dist export-ignore
/.gitattributes   export-ignore
